[sub_resource type="Shader" id="Shader_static"]
code = "shader_type canvas_item;

void fragment() {
	float n = fract(sin(dot(UV + vec2(TIME), vec2(12.9898, 78.233))) * 43758.5453);
	COLOR = vec4(vec3(n), 0.25);
}
"

